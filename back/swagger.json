{
  "openapi": "3.0.0",
  "info": {
    "title": "API La Remise",
    "version": "1.0.0",
    "description": "API de gestion de la ressourcerie La Remise"
  },
  "servers": [
    { "url": "/api" }
  ],
  "paths": {
    "/categories": {
      "get": {
        "summary": "Liste toutes les catégories",
        "responses": {
          "200": { "description": "La liste des catégories (id et libelle)" }
        }
      }
    },
    "/objets": {
      "get": {
        "summary": "Liste des objets, avec le libellé de leur catégorie",
        "parameters": [
          {
            "in": "query",
            "name": "statut",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["arrive", "en_reparation", "en_rayon", "vendu", "recycle"]
            },
            "description": "Filtre optionnel sur le statut"
          },
          {
            "in": "query",
            "name": "categorie_id",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Filtre optionnel sur la catégorie"
          }
        ],
        "responses": {
          "200": { "description": "La liste des objets (filtrée ou non)" }
        }
      }
    },
    "/objets/{id}": {
      "get": {
        "summary": "Récupère un objet par son id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "L'objet, sa catégorie, son dépôt et sa donatrice" },
          "404": { "description": "Objet introuvable" }
        }
      }
    },
    "/objets/{id}/statut": {
      "patch": {
        "summary": "Fait évoluer le statut d'un objet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["statut"],
                "properties": {
                  "statut": {
                    "type": "string",
                    "enum": ["arrive", "en_reparation", "en_rayon", "vendu", "recycle"]
                  },
                  "prix": { "type": "number" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Objet mis à jour" },
          "400": { "description": "Statut invalide ou manquant" },
          "404": { "description": "Objet introuvable" }
        }
      }
    },
    "/depots": {
      "get": {
        "summary": "Liste tous les dépôts",
        "responses": {
          "200": { "description": "La liste des dépôts" }
        }
      },
      "post": {
        "summary": "Enregistre un nouveau dépôt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["personne_id", "date_depot", "type"],
                "properties": {
                  "personne_id": { "type": "integer" },
                  "date_depot": { "type": "string", "format": "date" },
                  "type": {
                    "type": "string",
                    "enum": ["boutique", "domicile"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Dépôt créé" },
          "400": { "description": "Champs manquants ou invalides" }
        }
      }
    },
    "/depots/{id}": {
      "get": {
        "summary": "Récupère un dépôt par son id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Le dépôt, sa donatrice, et la liste de ses objets" },
          "404": { "description": "Dépôt introuvable" }
        }
      }
    },
    "/depots/{id}/objets": {
      "post": {
        "summary": "Ajoute un objet à un dépôt existant",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["libelle", "poids_kg", "etat_arrivee", "categorie_id"],
                "properties": {
                  "libelle": { "type": "string" },
                  "poids_kg": { "type": "number" },
                  "etat_arrivee": {
                    "type": "string",
                    "enum": ["bon_etat", "a_reparer", "hors_service"]
                  },
                  "categorie_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Objet créé et rattaché au dépôt" },
          "400": { "description": "Champs manquants ou invalides" }
        }
      }
    },
    "/personnes": {
      "get": {
        "summary": "Liste toutes les personnes",
        "responses": {
          "200": { "description": "La liste des personnes" }
        }
      },
      "post": {
        "summary": "Crée une nouvelle personne (donatrice)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nom", "prenom"],
                "properties": {
                  "nom": { "type": "string" },
                  "prenom": { "type": "string" },
                  "telephone": { "type": "string" },
                  "adherente": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Personne créée" },
          "400": { "description": "Champs manquants ou invalides" }
        }
      }
    },
    "/personnes/{id}": {
      "get": {
        "summary": "Récupère une personne par son id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "La personne correspondante" },
          "404": { "description": "Personne introuvable" }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Renvoie les indicateurs de La Remise",
        "responses": {
          "200": {
            "description": "Objets par statut, poids total reçu, poids détourné de la déchetterie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "objets_par_statut": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "statut": { "type": "string" },
                          "count": { "type": "integer" }
                        }
                      }
                    },
                    "poids_total_recu": { "type": "number" },
                    "poids_detourne_dechetterie": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}