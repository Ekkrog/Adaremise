      },
      "post": {
        "summary": "Crée un nouveau dépôt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["date_depot", "type", "objets_id"],
                "properties": {
                  "date_depot": { "type": "string", "format": "date" },
